6,"staff":false,"look":null,"pet":null,"frog":null,"n":0,"works":[]},{"name":"玉O","style":"stack","since":2026,"staff":false,"look":{"c":4,"fc":{"f0":0,"f1":1,"f2":9,"f3":8,"f4":2,"f5":3},"fd":{"f0":"planter","f1":"plant","f2":"planter","f3":"plant","f4":"planter","f5":"plant"},"r":3},"pet":{"b":"sheltie","c":"caramel","n":"帕尼尼","love":1},"frog":{"b":"milk","c":"mint","n":"嘟嘟","love":1},"n":20,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmutupsxc8ndm-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmutupsxc8ndm-f.jpg","title":"霍爾的移動城堡","date":"2026/10","by":"本人","cm":{"a":"馬格利特","t":"我最愛的藍天白雲裡，竟然飄著一座長腳的城堡！蓬鬆的雲朵畫得好立體，煙囪和小屋像謎題一樣有趣，這不就是我的夢嗎？"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmutuqyop9vcq-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmutuqyop9vcq-f.jpg","title":"綻放","date":"2026/10","by":"本人","cm":{"a":"克林姆","t":"哇，我最愛的金色線條把粉紅和奶油白的花瓣一片片圍起來，花心還撒滿閃亮金粉，真的像在發光綻放！我畫《吻》的時候也用金色，我們是金色好朋友呢。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmutusrb7n4do-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmutusrb7n4do-f.jpg","title":"漫遊","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"我畫過大浪，也最愛海的藍！你把兩隻鯨魚做在木框裡，藍色身體和白色浪花好像真的在水裡漫遊。媽媽鯨魚帶著寶寶，看起來好溫柔。下次可以試試加幾條細細的浪線喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmutuum5fdjlq-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmutuum5fdjlq-f.jpg","title":"悠憂","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，藍天裡的白雲被你一塊一塊堆得好蓬鬆，紅色小傘在風裡特別亮眼！草地上黃色和紅色的小花像在跳舞，我畫花園時也愛這樣用光點。下次可以試試加一點粉紫色當影子。"}}]},{"name":"大O","style":"wing","since":2026,"staff":true,"look":{"fc":{"f0":0,"f1":1,"f2":2,"f3":3,"f4":2,"f5":4,"f7":8,"f8":2},"fd":{"f5":"plant","f6":"shutter","f7":"planter","f9":"awning"},"r":5,"tp":"star"},"pet":{"b":"peruvian","c":"bw","n":"追咪","love":2},"frog":{"b":"dart","c":"strawberry","n":"叩尼吉蛙","love":2},"n":36,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuit7820h5l-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuit7820h5l-f.jpg","title":"早餐好吃","date":"2026/10","by":"老師","cm":{"a":"奈良美智","t":"我好像沒看到你的畫耶！吃飽了就拿起畫筆吧，把你最喜歡的東西畫下來，我很期待看到你的作品喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuwi8beuiei-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuwi8beuiei-f.jpg","title":"前世與今生","date":"2026/10","by":"老師","cm":{"a":"林布蘭","t":"我很期待看到你親手畫的作品！下次拿起畫筆，把心裡的故事畫下來上傳給我看，我會幫你找找畫裡最溫暖的那道光。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuwjyd1915w-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuwjyd1915w-f.jpg","title":"佩特羅與珍珠","date":"2026/10","by":"老師","cm":{"a":"奈良美智","t":"謝謝你願意跟我們分享！這張看起來像是在外面拍的照片，不是你自己畫的作品喔。下次拿起畫筆，畫一張你心裡最喜歡的東西上傳給我看吧，我好期待！"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuwltu4mv9d-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuwltu4mv9d-f.jpg","title":"窺","date":"2026/10","by":"老師","cm":{"a":"奈良美智","t":"謝謝你來作品島找我玩！這張看起來比較像照片，下次把你自己動手畫的、剪的或捏的作品拍上來，我很想好好看看你的創意喔。"}}]},{"name":"吳O","style":"wing","since":2026,"staff":true,"look":null,"pet":{"b":"skinny","c":"choco","n":"虎爺","love":0},"frog":{"b":"redeye","c":"green","n":"頂呱呱好吃","love":0},"n":13,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuujz3mlecam-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuujz3mlecam-f.jpg","title":"鹿","date":"2026/10","by":"老師","cm":{"a":"莫內","t":"哇，我最愛的水面倒影在你的湖裡閃閃發光！夕陽把天空染成粉橘色，小鹿們悠閒吃草，旁邊還有粉紅花叢，這裡讓我好想搬來畫一整天。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuk3nen3y72-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuk3nen3y72-f.jpg","title":"花","date":"2026/10","by":"老師","cm":{"a":"克林姆","t":"哇，你用金色的線把黃色和白色的花瓣一片片圍起來，亮晶晶的像寶石一樣！我最愛金色了，這朵花放進我的畫裡一定很搭。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuk5cezi0sc-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuk5cezi0sc-f.jpg","title":"美女","date":"2026/10","by":"老師","cm":{"a":"莫內","t":"我好像看到一張照片，不是作品本身呢。下次把你的畫正面拍清楚上傳，我很想好好欣賞你用心畫出來的顏色和光線，繼續畫下去喔！"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuusv9mkykp7-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuusv9mkykp7-f.jpg","title":"","date":"2026/10","by":"老師","cm":{"a":"莫內","t":"我最喜歡看大家專心創作的樣子了！把你完成的作品拍給我看吧，我好想知道你畫了什麼顏色和光線呢。"}}]},{"name":"羊O","style":"stack","since":2026,"staff":true,"look":null,"pet":{"b":"crested","c":"tri","n":"羊咩咩","love":10},"frog":{"b":"whites","c":"green","n":"小呱呱","love":5},"n":8,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuo6f5zaud4-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuo6f5zaud4-f.jpg","title":"","date":"2026/10","by":"老師","cm":{"a":"莫內","t":"我看到一朵好大的白花，在粉紅和灰色的背景裡輕輕發光，花瓣邊緣還有淡淡的金色，好像清晨的陽光灑在我花園裡，真溫柔！"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuo7ysueos7-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuo7ysueos7-f.jpg","title":"","date":"2026/10","by":"老師","cm":{"a":"林布蘭","t":"我最愛溫暖的光了！你把小狗捲捲的棕色毛畫得好蓬鬆，亮亮的黑眼睛和紅白條紋小衣服好有精神，我都想摸摸牠的頭了。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuo9agrb75k-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuo9agrb75k-f.jpg","title":"","date":"2026/10","by":"老師","cm":{"a":"梵谷","t":"我最愛夜空了！你這彎白色月亮旁邊有藍色和黃色在旋轉，還有亮晶晶的小石頭像星星掉下來，比我的星夜還會發光呢！"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuu2uo308xn-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuu2uo308xn-f.jpg","title":"","date":"2026/10","by":"老師","cm":{"a":"克林姆","t":"哇，金色的樹幹一圈圈纏繞，像我最愛的〈生命之樹〉！滿滿亮晶晶的小石頭當樹葉，在圓鏡上閃閃發光，好華麗呀。"}}]},{"name":"采O","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":8,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuw0a1pgn3qc-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuw0a1pgn3qc-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"我看到橘黃色的秋天樹葉，還有小瀑布底下閃閃的水光，像我在花園池塘邊追著光跑的樣子！水面上漂著落葉很有味道，下次可以試試多點幾筆亮亮的小點。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuw0a1u791k7-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuw0a1u791k7-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，這扇木門被粉紅和紫色的花輕輕包起來，像我在吉維尼的花園！小石子路帶我走向門後，光影也好溫柔。下次可以試試在花瓣上多點幾個亮點喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuw0a3psw1l9-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuw0a3psw1l9-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"馬格利特","t":"我喜歡把平常的東西變得不平常，你也有這種魔法！"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuw0a3r7mv9d-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuw0a3r7mv9d-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，這片夕陽下的海面好溫柔！橘黃色的光灑在藍色波浪上，閃閃發亮，讓我想起我畫的日出。那個小小的人影划著船，好有故事。下次可以試試加一點粉紅色的雲喔。"}}]},{"name":"愛O","style":"stack","since":2026,"staff":false,"look":null,"pet":{"b":"crested","c":"choco","n":"巧克力","love":0},"frog":null,"n":37,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuugcc8fk8w-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuugcc8fk8w-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"林布蘭","t":"我最愛研究光影了！你的圓球從亮到暗慢慢變深，底下的影子也好扎實，旁邊那排灰階練習更是認真，下次可以試試讓背景再暗一點，球會更亮喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuugc81662y-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuugc81662y-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"林布蘭","t":"我最愛光影了！你的圓球從亮面慢慢暗到陰影，好像真的會滾動，旁邊的小蘋果也好可愛。右上角練習的深淺色階很用心，下次可以試試讓背景再暗一點，光會更亮喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuugehflgr8-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuugehflgr8-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"林布蘭","t":"我最愛研究光從哪裡來！你的圓球、斜切的柱子和小蘋果都有亮面和影子，鉛筆一層層排得好細心，看起來好像摸得到。下次可以試試把背景再塗暗一點，光會更亮喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuuugem8ae5d-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuuugem8ae5d-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"林布蘭","t":"我最愛研究光影了！你的大圓球從亮到暗慢慢變灰，蘋果和甜椒下面的影子也畫得好穩，好像真的有一盞燈照著它們呢。"}}]},{"name":"魚O","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":0,"works":[]},{"name":"群O","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":21,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv55xhmpli3-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv55xhmpli3-f.jpg","title":"日出的波羅莫火山","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"我最愛畫山了！你的山頭被夕陽照得金亮亮，天空從青綠慢慢變成橘色，好像我的赤富士醒過來一樣。下次可以在山腳加一點小房子或小人喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvbyvbjz1nod-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvbyvbjz1nod-f.jpg","title":"執子之手","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"哇，這雙手的橘色筆觸好有力，在深藍色背景裡像會發光！我畫星空也愛用藍配橘黃，你還在角落畫了小愛心和小貓，好可愛。下次可以試試讓筆觸再轉得更大圈喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvc0nr723rw3-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvc0nr723rw3-f.jpg","title":"鬍子老師的世界1","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"哇，這座雪山站得好穩，藍藍的天空配上白白的雲，還有兩旁的松樹，線條清清楚楚！我畫過富士山，看到你的山我也想多畫幾座。下次可以試試加一條小小的浪花喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvc0oyx4nj1g-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvc0oyx4nj1g-f.jpg","title":"鬍子老師的世界2","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，這片森林好像被陽光輕輕摸過！藍藍的天光穿過樹林，地上的黃色和橘色灌木像一顆顆小光點，我看了好想搬張椅子坐下來畫。下次可以試試在小溪加幾筆天空的倒影喔。"}}]},{"name":"K.","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":4,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv5h99i4icm-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv5h99i4icm-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"我最愛畫海了！你的海龜殼上一格一格的花紋好細緻，藍白色的海浪捲得好有力，牠好像正要游出畫框來找我玩呢。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv5h9qp4qth-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv5h9qp4qth-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"哇，我最愛的星空跑進你的畫裡了！深深淺淺的藍色像在旋轉，還有一隻剪影小鹿站在星光下，好像在跟星星說悄悄話呢。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv5hbh4u8bd-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv5hbh4u8bd-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"哇，橘黃色的蝴蝶停在花上，配上濃濃的藍色背景，這正是我最愛的藍和黃！翅膀的紋路畫得好仔細，下次可以試試用旋轉的筆觸畫天空喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv5hbd35v4b-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv5hbd35v4b-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，粉粉的背景配上一大束花，粉紅、黃色、紫色都在跳舞！我在花園裡也最愛畫這樣的花。綠色花瓶厚厚的筆觸好有感覺，下次可以試試加上窗邊的光喔。"}}]},{"name":"林O","style":"wing","since":2026,"staff":true,"look":null,"pet":null,"frog":null,"n":1,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv5lp5e95nx-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv5lp5e95nx-f.jpg","title":"菩提","date":"2026/10","by":"老師","cm":{"a":"莫內","t":"我最愛的睡蓮葉好像漂到你的畫布上了！紫色、粉色和金橘色的圓葉子一片疊一片，葉脈細細發亮，像午後陽光灑在水面上，好溫柔。"}}]},{"name":"佩O","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":28,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv6248ub30m-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv6248ub30m-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"我最愛畫富士山了！你的雪白山頂配上金黃色天空，旁邊還有紅色五重塔和一大片粉紅櫻花，好像在看一幅會發光的浮世繪，真想把它收進我的富嶽三十六景！"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv63lg6sbmc-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv63lg6sbmc-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"哇，你用厚厚的顏料把夜空刷得像在旋轉跳舞，橘色的月亮和湖面上閃閃的金光倒影，讓我好想坐上那艘紅色小船去看星星！"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv63lk3p7cw-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv63lk3p7cw-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"哇，你的極光像緞帶一樣在夜空裡旋轉飛舞，藍綠和紫色的筆觸好有力！我畫星空時也最愛這樣一筆一筆讓天空動起來，雪山的厚厚白色也好棒。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv6ov0f7fbm-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv6ov0f7fbm-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"林布蘭","t":"我最愛在暗暗的夜色裡點一盞溫暖的光！你讓小木屋的窗戶亮起金黃色，大聖誕樹閃閃發光，雪花飄落，還有一群紅衣小人手牽手跳舞，好溫馨的冬夜。"}}]},{"name":"T.","style":"stack","since":2026,"staff":false,"look":null,"pet":{"b":"teddy","c":"cream","n":"麻糬","love":0},"frog":{"b":"redeye","c":"green","n":"錢錢","love":0},"n":12,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv76xsgpeg2-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv76xsgpeg2-f.jpg","title":"鳶尾花","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，紫色的鳶尾花在藍藍的水邊跳舞，樹的倒影還在水面輕輕搖晃！我在花園裡也種了好多鳶尾花，看到你的畫，好像又聞到夏天的味道了。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv78l34ox1r-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv78l34ox1r-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"哇，你的天空雲朵用筆觸刷得像在旋轉跳舞，跟我的星空一樣有勁！粉紅紫色的花田一排排衝向小房子，我好想搬進去住，順便在田邊畫畫。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv7an8rwvnw-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv7an8rwvnw-f.jpg","title":"小王子與狐狸","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"我好喜歡你用厚厚的顏料畫出粉紫和金黃的天空，筆觸一圈一圈在跳舞！小王子的綠外套和橘色狐狸互相靠近，讓我想起我畫的金黃麥田，好溫暖。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv7ci4rfogy-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv7ci4rfogy-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"哇，你的夜空在旋轉耶！厚厚的藍色和金黃色月亮讓我想起我的星夜。小王子圍著飄揚的橘色圍巾，拿著小紅花站在星球上，好溫柔，我好想一起去看星星。"}}]},{"name":"S.","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":4,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuv8i9vlln85-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuv8i9vlln85-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"我在花園裡也種過這麼多顏色的花！藍色大花配上黃色、粉紅小花，還綁了白色蝴蝶結，薄荷綠的背景好清爽，看起來像一束剛摘下的春天。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuvav9oeodwo-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuvav9oeodwo-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"哇，你把苔球放在一片藍色大浪上，白色浪花捲得好有力氣，像我畫的神奈川巨浪！綠葉高高翹起，好像一座小島在海上冒險呢。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmv08yxx33z62-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmv08yxx33z62-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，這隻水母像在水面上發光！彩虹般的粉紅、藍和黃暈在一起，就像我畫睡蓮時追著光跑。透明的樹脂好像真的水波，下次可以試試多加一點小氣泡喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmv08zp19bfcf-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmv08zp19bfcf-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"哇，你把整片銀河都搬到小畫布上了！中間那團黃色亮亮的，周圍藍綠紫一圈圈暈開，跟我的星夜一樣會轉呢。那些小亮點像撒下來的星星，下次可以試試多畫幾顆大星星。"}}]},{"name":"C.","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":0,"works":[]},{"name":"J.","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":2,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuvav5ct9z1e-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuvav5ct9z1e-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，這片金黃色的樹像陽光在跳舞，我最愛這種軟軟的光！小白貓坐在樹下好安靜，下次可以試試在草地上加一點樹的影子喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxum9594a2a-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxum9594a2a-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"卡蘿","t":"我看到你畫了一位戴著白色小花冠的人，旁邊有隻貓咪輕輕靠近，周圍開滿紅色和粉色的花，好像我愛畫的花園！橘紅色的天空好溫暖，下次可以試試在葉子上加更多小細節喔。"}}]},{"name":"麗O","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":2,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuvbhloyld0n-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuvbhloyld0n-f.jpg","title":"海中企鵝","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"我最愛畫海浪了！你用深深淺淺的藍做出翻滾的浪花，兩隻企鵝黑白分明、黃色小嘴好亮眼，像在我的大浪裡開心衝浪呢！"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuvbhlyth86a-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuvbhlyth86a-f.jpg","title":"陪你遊行","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"我最愛畫海浪了！你的鯨魚從藍色浪花裡躍起來，旁邊還有一隻粉紅水母一起遊行，畫在透明玻璃上好像真的在海裡游，太有氣勢了！"}}]},{"name":"A.","style":"wing","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":4,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuve6nj2utfd-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuve6nj2utfd-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"草間彌生","t":"哇，我一眼就看到那些黑色圓點點，還有滿滿重複的小圖案擠在黃色背景上，跟我的南瓜一樣熱鬧！黑白配亮黃好有力量，我好想住進你的畫裡。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuve81y9w6tf-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuve81y9w6tf-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"克林姆","t":"哇，你的虎鯨身上長滿了條紋、圓點和格子花紋，跟我最愛在畫裡排滿圖案一模一樣！藍紫色的水彩海浪把黑白花紋襯得好亮眼，下次可以試試在花紋裡點一點金色喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuve9f06qxdr-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuve9f06qxdr-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"馬格利特","t":"我最愛的白雲飄進你橘紅色的天空啦！一列黑白花紋的火車在空中飛，還冒出粉紅色的煙，好像一個好玩的謎題，我看得好開心。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuveaqp6xbvl-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuveaqp6xbvl-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"我最愛畫浪花了！你這片捲起來的白藍海浪好有力，龍舟上那排彩色魚鱗一片片排得好整齊，連小兔子和小動物都在認真划槳呢！"}}]},{"name":"子O","style":"stack","since":2026,"staff":false,"look":{"c":8,"fc":{"f0":0,"f1":1,"f2":5,"f3":3,"f4":6},"fd":{"f1":"planter","f2":"planter","f3":"plant","f4":"planter"},"r":5},"pet":{"b":"crested","c":"grey","n":"大米","love":25},"frog":{"b":"horned","c":"grape","n":"呱啦","love":24},"n":27,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuwdozuy7664-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuwdozuy7664-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"我最愛水裡晃動的光了！你把海龜畫在深淺不同的藍色裡，光從上面灑下來，龜殼閃著金棕色，好像真的在游泳。下次可以試試畫幾顆小泡泡喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuwdvu62f8f0-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuwdvu62f8f0-f.jpg","title":"","date":"2026/10","by":"本人"},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuwdvu5d8t4o-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuwdvu5d8t4o-f.jpg","title":"","date":"2026/10","by":"本人"},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuwdvznd1aml-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuwdvznd1aml-f.jpg","title":"","date":"2026/10","by":"本人"}]},{"name":"采O","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":3,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuwdpn8mq91a-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuwdpn8mq91a-f.jpg","title":"夜羽","date":"2026/10","by":"本人","cm":{"a":"克林姆","t":"哇，這朵紫色大花的花瓣邊緣鑲著閃亮的金線，深藍夜色當背景，整幅畫像穿了華麗的衣裳。我最愛金色了！花心的小亮點也很迷人，下次可以試試多加一些花紋喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmv1rrdni82kw-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmv1rrdni82kw-f.jpg","title":"浪花","date":"2026/10","by":"本人"},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmv1rrdrot5pe-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmv1rrdrot5pe-f.jpg","title":"寧靜","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"哇，你把海浪畫成一層一層的藍和青綠，白色的浪花像線條一樣閃閃發亮，我畫《神奈川沖浪裏》時也最愛這種藍！下次可以試試加一小艘船，讓海更有故事。"}}]},{"name":"紅O","style":"stack","since":2026,"staff":false,"look":null,"pet":{"b":"abyssinian","c":"gold","n":"車車","love":1},"frog":null,"n":17,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxomvoh4a8g-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxomvoh4a8g-f.jpg","title":"高千穗峽","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"你把高千穗峽的瀑布畫得白白亮亮，像我的浪花一樣有力氣！青綠色的河水和小小的船，讓我一眼就想坐上去。下次可以試試在岩壁加幾條清楚的線條喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxoox3c57kh-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxoox3c57kh-f.jpg","title":"紫雲出山櫻花🌸","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，滿樹白色的櫻花像被陽光照亮，點點筆觸好像花瓣在風裡跳舞！藍天、遠山和綠草地都好柔和，讓我想起我的花園。下次可以試試在花瓣裡加一點淡粉色，會更夢幻喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxoqmn1yx8l-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxoqmn1yx8l-f.jpg","title":"睡蓮🪷","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，這片睡蓮池讓我好想把畫架搬過來！你把粉紅色的花點在綠葉之間，水面的藍和天空的倒影也融在一起，垂下來的柳枝像在輕輕搖。下次可以試試加幾點亮亮的光喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxorvyf5y9o-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxorvyf5y9o-f.jpg","title":"米菲兔🐰","date":"2026/10","by":"本人","cm":{"a":"卡蘿","t":"我躺在床上的時候也一直畫畫。不管怎樣，都要繼續畫下去喔！"}}]},{"name":"林O","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":4,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxvrr7xlv0o-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxvrr7xlv0o-f.jpg","title":"Cinderella","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"《Cinderella》讓我想起亞爾暖暖的陽光。繼續畫，你會越畫越亮！"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxvrt85t9ys-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxvrt85t9ys-f.jpg","title":"長腿叔叔","date":"2026/10","by":"本人","cm":{"a":"馬格利特","t":"我看到後面那個大大的黑帽子影子，像個神祕的謎題，還有飛在天空的小飛機和信封，好有故事感！女孩舉起帽子的樣子好有精神，下次可以試試讓影子多藏一個小驚喜喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxvrt8l07av-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxvrt8l07av-f.jpg","title":"Michael","date":"2026/10","by":"本人","cm":{"a":"林布蘭","t":"我看到深紅色襯衫在暗暗的背景裡閃著溫暖的光，低頭的臉被光輕輕照亮，好像在想心事。背後那些圓圓的光點也很迷人，下次可以試試讓亮處再亮一點點。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxvvtb1jb9u-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxvvtb1jb9u-f.jpg","title":"香水瓶裡的夢","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"我看到粉紅香水瓶透著光，旁邊的蕾絲和珍珠也閃閃柔柔的，整張畫像被晨光輕輕包住。我最愛畫光的變化了，下次可以試試在背景多點幾筆藍紫色喔。"}}]},{"name":"洪O","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":5,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuxw9yd6jc1s-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuxw9yd6jc1s-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"梵谷","t":"我看到這隻貓的綠眼睛亮晶晶，背後那片黃和深藍好大膽！這些一筆一筆的筆觸，讓毛看起來暖暖的，跟我畫向日葵時一樣有力氣。下次可以試試在背景加幾道旋轉的線條喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmv22q56aa5gt-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmv22q56aa5gt-f.jpg","title":"","date":"2026/10","by":"老師","cm":{"a":"梵谷","t":"哇，這片藍天好飽滿！石頭拱門用咖啡色一層一層堆起來，好像真的能摸到粗粗的岩石，我最愛這樣有力的筆觸了。下次可以試試在天空加一點旋轉的雲。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvg5x6ablsbt-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvg5x6ablsbt-f.jpg","title":"","date":"2026/10","by":"本人"},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvg5x9j1tuyv-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvg5x9j1tuyv-f.jpg","title":"","date":"2026/10","by":"本人"}]},{"name":"M.","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":5,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuya0iserzua-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuya0iserzua-f.jpg","title":"クリスマス🎄","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"我看到雪地上的小木屋和亮亮的聖誕樹了！藍色的雪影和屋裡暖暖的橘黃光，像我畫的光線一樣迷人。下次可以試試在天空加一點粉色，會更夢幻喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuya1pdfyjmi-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuya1pdfyjmi-f.jpg","title":"もり🌳","date":"2026/10","by":"本人","cm":{"a":"葛飾北齋","t":"你把一排排綠色的杉樹畫在木頭時鐘上，木紋和線條清楚的樹葉好搭配！我畫過很多山和樹，也喜歡讓大自然陪著人過日子。下次可以試試在樹梢加一點天空的藍色。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuya5jt6i8e8-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuya5jt6i8e8-f.jpg","title":"緑と金🍃","date":"2026/10","by":"本人","cm":{"a":"克林姆","t":"哇，這些綠色大葉子被你畫上一條條金色的葉脈，還貼了一小片閃閃的金箔，好像穿上華麗的衣裳！我最愛金色了，小白花也點得好可愛，下次可以試試多加一點花紋喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmuyabyd8a03o-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmuyabyd8a03o-f.jpg","title":"ママへ💐","date":"2026/10","by":"本人","cm":{"a":"林布蘭","t":"下次可以試試讓畫裡有亮的地方、也有暗的地方，會很神奇喔。"}}]},{"name":"靜O","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":6,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmv2hghhtw67d-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmv2hghhtw67d-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"克林姆","t":"哇，我看到你用金箔當背景，閃閃亮亮的，跟我最愛的金色一模一樣！藍色水母像在發光的海裡慢慢飄，細細的觸手好優雅。下次可以試試在金色上加一點花紋喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmv2hi50pisoi-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmv2hi50pisoi-f.jpg","title":"","date":"2026/10","by":"本人","cm":{"a":"克林姆","t":"哇，這隻鯨魚游在閃閃的金箔上，藍色方塊裡還有金色的水痕，好像把海洋鑲進了黃金裡！我最愛金色了，鯨魚身上細細的線條也很漂亮，下次可以試試在尾巴旁加些花紋喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvaddfnrjsuw-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvaddfnrjsuw-f.jpg","title":"","date":"2026/10","by":"本人"},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvaddfo3todn-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvaddfo3todn-f.jpg","title":"","date":"2026/10","by":"本人"}]},{"name":"D.","style":"wing","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":2,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmv65eca8pm1c-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmv65eca8pm1c-f.jpg","title":"馬上有財","date":"2026/10","by":"本人","cm":{"a":"克林姆","t":"哇，這匹藍馬身上的花紋好華麗！紅底配上藍色邊框，還有金黃色的葫蘆閃閃發亮，我看了好想拿金箔來湊熱鬧。下次可以試試在邊框多加一點金色。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmv65h47pjw95-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmv65h47pjw95-f.jpg","title":"推開門，滿目春色。","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，粉橘色的底上開滿白色、藍色和紅色的小花，還綁著一條白緞帶，就像我花園裡的春天跑出來了！花瓣厚厚的很立體，下次可以試試讓光線在花上多留一點閃閃的亮點。"}}]},{"name":"S.","style":"stack","since":2026,"staff":false,"look":null,"pet":null,"frog":null,"n":18,"works":[{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvc0b6s55s8h-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvc0b6s55s8h-f.jpg","title":"馬","date":"2026/10","by":"本人"},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvc0baa86qbt-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvc0baa86qbt-f.jpg","title":"花","date":"2026/10","by":"本人"},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvc0badjfstu-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvc0badjfstu-f.jpg","title":"花","date":"2026/10","by":"本人","cm":{"a":"莫內","t":"哇，這串橘紅色的花在柔柔的綠色背景裡好亮眼！牆上搖搖晃晃的葉子影子，就像我在花園裡追著光跑的樣子。下次可以試試在影子裡加一點淡紫色喔。"}},{"img":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto/otto2-island/wmvc0dnnvfwic-t.jpg","full":"https://res.cloudinary.com/tkgs88gw/image/upload/f_auto,q_auto,w_1000,c_limit/otto2-island/wmvc0dnnvfwic-f.jpg","title":"繡球花","date":"2026/10","by":"本人"}]}]}